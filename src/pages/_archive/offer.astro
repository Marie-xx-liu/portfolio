---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import { seo } from '../data/site';

const layers = [
  {
    n: '01',
    key: 'strategy',
    label: 'Strategy',
    meaning: 'Helping you become a long-term winner',
    claim:
      'The balance worth designing for isn’t "how much can we automate" — it’s which equilibrium you steer into: a substitution trap, or an embedding dividend. The long-term winners treat this as an institutional choice and build for the dividend deliberately.',
    demoId: '[OFFER-strategy]',
    demoLabel: 'Interactive framework — substitution trap ↔ embedding dividend',
  },
  {
    n: '02',
    key: 'business',
    label: 'Business',
    meaning: 'Stable optimization, never model-locked',
    claim:
      'AI embedded into the existing business chain to amplify it — not to bail it out. A supply-chain example: forecasting, procurement, inventory/routing, and exception-handling agents, each with a clear human approval point and a measurable gain.',
    demoId: '[OFFER-business-supplychain]',
    demoLabel: 'Supply-chain before/after — traditional chain vs agentic workflow',
  },
  {
    n: '03',
    key: 'product',
    label: 'Product',
    meaning: 'How to grow new-era teams',
    claim:
      'The PM who can do eval, cost the trade-offs, and turn disagreement into a number everyone can align on. Skills × tools × workflows × methodologies — the capability profile worth hiring and training for.',
    demoId: '[OFFER-product-toolmatrix]',
    demoLabel: 'PM tool matrix — skills × tools × workflows × methodologies',
  },
];
---

<BaseLayout title={seo['/offer'].title} description={seo['/offer'].description}>
  <PageHeader
    eyebrow="What I offer"
    title="Three altitudes of value."
    intro="From corporate strategy down to product execution — a coherent way to put AI to work that compounds capability instead of hollowing it out."
  />

  <div class="container-editorial py-12">
    {
      layers.map((layer) => (
        <section class="reveal grid gap-8 border-t border-line py-16 lg:grid-cols-[1fr_1fr]">
          <div>
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-sm text-accent">{layer.n}</span>
              <h2 class="font-display text-title">{layer.label}</h2>
            </div>
            <p class="mt-2 font-mono text-xs uppercase tracking-[0.12em] text-ink-muted">{layer.meaning}</p>
            <p class="mt-6 max-w-[48ch] text-lg leading-relaxed">{layer.claim}</p>
          </div>
          <div class="self-center">
            <Placeholder id={layer.demoId} ratio="4/3" label={layer.demoLabel} />
            <p class="mt-3 font-mono text-xs text-ink-muted">[ Phase 4: clean static · interactive in Phase 5 ]</p>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
