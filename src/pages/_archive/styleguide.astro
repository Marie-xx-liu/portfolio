---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import StatCounter from '../components/StatCounter.tsx';
import KineticHeading from '../components/KineticHeading.tsx';
import LogoMarquee from '../components/LogoMarquee.astro';
import LineworkMotif from '../components/LineworkMotif.astro';
import Placeholder from '../components/Placeholder.astro';

// ---- Color tokens (both themes for comparison) ----
const colorTokens = [
  { name: '--bg', role: 'Page background', dark: '#0E0E0F', light: '#F4F2ED' },
  { name: '--bg-elev', role: 'Elevated surface', dark: '#16161A', light: '#FFFFFF' },
  { name: '--ink', role: 'Primary text', dark: '#F4F2ED', light: '#1A1A1C' },
  { name: '--ink-muted', role: 'Secondary text', dark: '#9A9A93', light: '#6F6E66' },
  { name: '--line', role: 'Dividers / grid', dark: '#2A2A2E', light: '#E0DCCF' },
  { name: '--accent', role: 'Gold accent · <5% usage', dark: '#C8A45C', light: '#9C7327' },
  { name: '--accent-2', role: 'Secondary data', dark: '#6E7B8B', light: '#586473' },
];

// ---- Type scale ----
const typeScale = [
  { token: 'text-display', cls: 'text-display font-display', note: 'clamp(3rem → 8rem)', sample: 'Display' },
  { token: 'text-hero', cls: 'text-hero font-display', note: 'clamp(2.5rem → 5.5rem)', sample: 'Hero headline' },
  { token: 'text-title', cls: 'text-title font-display', note: 'clamp(2rem → 3.5rem)', sample: 'Section title' },
  { token: 'text-subtitle', cls: 'text-subtitle', note: 'clamp(1.125rem → 1.5rem)', sample: 'Subtitle / lead paragraph' },
  { token: 'text-base', cls: 'text-base', note: '16px / 1.6', sample: 'Body copy — the workhorse reading size for paragraphs and descriptions.' },
  { token: 'text-sm', cls: 'text-sm text-ink-muted', note: '14px', sample: 'Small / caption text in muted ink.' },
  { token: 'font-mono', cls: 'font-mono text-sm uppercase tracking-[0.14em]', note: 'JetBrains Mono', sample: 'Metric · label · 12,345' },
];

const spacing = [
  { name: '1', px: '4px' },
  { name: '2', px: '8px' },
  { name: '4', px: '16px' },
  { name: '6', px: '24px' },
  { name: '8', px: '32px' },
  { name: '12', px: '48px' },
  { name: '16', px: '64px' },
  { name: '24', px: '96px' },
];
const radii = [
  { name: 'sm', px: '4px', cls: 'rounded' },
  { name: 'md', px: '8px', cls: 'rounded-lg' },
  { name: 'lg', px: '12px', cls: 'rounded-xl' },
  { name: 'full', px: '999px', cls: 'rounded-full' },
];

const marqueeItems = ['Deloitte', 'AWS', 'Deutsche Post DHL', 'Bocconi', 'CAS · ZiDongTaiChu', 'DiPEAK'];
---

<BaseLayout title="Styleguide — Marie Xiaoxu Liu (dev only)" noindex={true} chrome={false}>
  <!-- Sticky control bar -->
  <div class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur">
    <div class="container-editorial flex flex-wrap items-center justify-between gap-4 py-4">
      <div>
        <p class="eyebrow">Design System · /styleguide</p>
        <p class="mt-1 text-sm text-ink-muted">
          Dev-only · <code>noindex</code> · not in nav or sitemap
        </p>
      </div>
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-ink-muted">Theme</span>
        <ThemeToggle client:load />
      </div>
    </div>
  </div>

  <div class="container-editorial space-y-28 py-20">
    <!-- Intro -->
    <header class="max-w-[40ch]">
      <KineticHeading
        client:visible
        text="A quiet system, built to scale."
        as="h1"
        className="text-hero font-display"
        accentWords={['scale.']}
      />
      <p class="mt-6 text-subtitle text-ink-muted">
        The full design language in one page — tokens, type, components, and motion.
        Toggle the theme above to compare <strong class="text-ink">dark</strong> and
        <strong class="text-ink">light / paper</strong>.
      </p>
    </header>

    <!-- A · COLOR -->
    <section aria-labelledby="sg-color" class="reveal" data-reveal>
      <p class="eyebrow mb-3">A · Color tokens</p>
      <h2 id="sg-color" class="text-title font-display">Palette</h2>
      <p class="mt-3 max-w-[60ch] text-ink-muted">
        Swatches reflect the <em>currently selected</em> theme. The table lists the
        raw hex for both. Accent gold is intentionally rationed to under 5% of any view.
      </p>

      <!-- current-theme swatches -->
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {
          colorTokens.map((t) => (
            <div class="card overflow-hidden">
              <div
                class="h-24 w-full border-b border-line"
                style={`background-color: var(${t.name});`}
              />
              <div class="p-3">
                <p class="font-mono text-xs text-ink">{t.name}</p>
                <p class="mt-1 text-xs text-ink-muted">{t.role}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- comparison table -->
      <div class="mt-8 overflow-x-auto">
        <table class="w-full border-collapse text-left font-mono text-sm">
          <thead>
            <tr class="border-b border-line text-ink-muted">
              <th class="py-3 pr-6 font-normal">Token</th>
              <th class="py-3 pr-6 font-normal">Role</th>
              <th class="py-3 pr-6 font-normal">Dark</th>
              <th class="py-3 font-normal">Light</th>
            </tr>
          </thead>
          <tbody>
            {
              colorTokens.map((t) => (
                <tr class="border-b border-line/60">
                  <td class="py-3 pr-6 text-ink">{t.name}</td>
                  <td class="py-3 pr-6 text-ink-muted">{t.role}</td>
                  <td class="py-3 pr-6">
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-block h-4 w-4 rounded border border-line" style={`background:${t.dark}`} />
                      {t.dark}
                    </span>
                  </td>
                  <td class="py-3">
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-block h-4 w-4 rounded border border-line" style={`background:${t.light}`} />
                      {t.light}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <hr class="hairline" />

    <!-- B · TYPOGRAPHY -->
    <section aria-labelledby="sg-type" class="reveal" data-reveal>
      <p class="eyebrow mb-3">B · Typography</p>
      <h2 id="sg-type" class="text-title font-display">Type system</h2>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="card p-6">
          <p class="eyebrow mb-3">Display · Fraunces</p>
          <p class="font-display text-5xl">Ag</p>
          <p class="mt-2 text-sm text-ink-muted">Editorial serif for kinetic headings.</p>
        </div>
        <div class="card p-6">
          <p class="eyebrow mb-3">Sans · Inter</p>
          <p class="text-5xl">Ag</p>
          <p class="mt-2 text-sm text-ink-muted">Body &amp; UI grotesk.</p>
        </div>
        <div class="card p-6">
          <p class="eyebrow mb-3">Mono · JetBrains</p>
          <p class="font-mono text-5xl">Ag</p>
          <p class="mt-2 text-sm text-ink-muted">Numbers, metrics, code, labels.</p>
        </div>
      </div>

      <div class="mt-10 space-y-8">
        {
          typeScale.map((t) => (
            <div class="grid items-baseline gap-2 border-b border-line/60 pb-6 md:grid-cols-[200px_1fr]">
              <div class="font-mono text-xs text-ink-muted">
                <span class="text-ink">{t.token}</span>
                <br />
                {t.note}
              </div>
              <div class={t.cls}>{t.sample}</div>
            </div>
          ))
        }
      </div>
    </section>

    <hr class="hairline" />

    <!-- C · SPACING & RADIUS -->
    <section aria-labelledby="sg-space" class="reveal" data-reveal>
      <p class="eyebrow mb-3">C · Spacing &amp; radius</p>
      <h2 id="sg-space" class="text-title font-display">Rhythm</h2>
      <div class="mt-8 grid gap-12 lg:grid-cols-2">
        <div>
          <p class="eyebrow mb-4">Spacing scale (Tailwind units)</p>
          <div class="space-y-2">
            {
              spacing.map((s) => (
                <div class="flex items-center gap-4">
                  <span class="w-16 font-mono text-xs text-ink-muted">
                    {s.name} · {s.px}
                  </span>
                  <span class="h-4 bg-accent/70" style={`width:${s.px}`} />
                </div>
              ))
            }
          </div>
        </div>
        <div>
          <p class="eyebrow mb-4">Radius</p>
          <div class="flex flex-wrap gap-6">
            {
              radii.map((r) => (
                <div class="text-center">
                  <div class={`h-20 w-20 border border-line bg-bg-elev ${r.cls}`} />
                  <p class="mt-2 font-mono text-xs text-ink-muted">
                    {r.name}
                    <br />
                    {r.px}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <hr class="hairline" />

    <!-- D · MOTIF -->
    <section aria-labelledby="sg-motif" class="reveal" data-reveal>
      <p class="eyebrow mb-3">D · Background motif (A · line-work)</p>
      <h2 id="sg-motif" class="text-title font-display">Structure motif</h2>
      <p class="mt-3 max-w-[60ch] text-ink-muted">
        Default motif — generative-looking contour lines, kept static and weak.
        Used once behind the hero; never a full-screen screensaver.
      </p>
      <div class="relative mt-8 h-64 overflow-hidden rounded-xl border border-line bg-bg-elev">
        <LineworkMotif opacity={0.6} />
        <div class="relative z-10 flex h-full items-center justify-center">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-muted">
            time · lever · embedding
          </p>
        </div>
      </div>
    </section>

    <hr class="hairline" />

    <!-- E · BUTTONS & LINKS -->
    <section aria-labelledby="sg-btn" class="reveal" data-reveal>
      <p class="eyebrow mb-3">E · Buttons &amp; links</p>
      <h2 id="sg-btn" class="text-title font-display">Actions</h2>
      <p class="mt-3 text-sm text-ink-muted">Hover and tab through to see hover / focus states.</p>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <button class="btn btn-primary">Primary action →</button>
        <button class="btn btn-outline">Secondary</button>
        <a href="#sg-btn" class="link-underline text-sm">Inline link with underline sweep</a>
        <a href={'#'} class="text-sm text-accent underline underline-offset-4 transition-opacity hover:opacity-70">
          Accent link →
        </a>
      </div>
    </section>

    <hr class="hairline" />

    <!-- F · FORM STATES -->
    <section aria-labelledby="sg-form" class="reveal" data-reveal>
      <p class="eyebrow mb-3">F · Form states</p>
      <h2 id="sg-form" class="text-title font-display">Inputs</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        <div>
          <label class="field-label" for="sg-default">Default</label>
          <input class="input" id="sg-default" placeholder="you@example.com" />
        </div>
        <div>
          <label class="field-label" for="sg-error">Error</label>
          <input class="input" id="sg-error" aria-invalid="true" value="not-an-email" />
          <p class="field-msg field-msg--error">Please enter a valid email.</p>
        </div>
        <div>
          <label class="field-label" for="sg-success">Success</label>
          <input class="input" id="sg-success" data-state="success" value="marie@example.com" />
          <p class="field-msg field-msg--success">Looks good.</p>
        </div>
      </div>
    </section>

    <hr class="hairline" />

    <!-- G · PLACEHOLDER -->
    <section aria-labelledby="sg-ph" class="reveal" data-reveal>
      <p class="eyebrow mb-3">G · Missing-asset placeholder</p>
      <h2 id="sg-ph" class="text-title font-display">Placeholder</h2>
      <p class="mt-3 max-w-[60ch] text-ink-muted">
        Stands in for any missing <code>[ID]</code> media. Never fabricated content —
        just a labeled grey block so gaps are obvious.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <Placeholder id="[IMG-EXP-ZDT]" label="Platform screenshot" ratio="16/9" />
        <Placeholder id="[VIDEO-PM-02]" label="15s product clip" ratio="16/9" />
        <Placeholder id="[LOGO-DIPEAK]" label="Employer logo" ratio="1/1" />
      </div>
    </section>

    <hr class="hairline" />

    <!-- H · PRIMITIVES -->
    <section aria-labelledby="sg-prim" class="reveal" data-reveal>
      <p class="eyebrow mb-3">H · Signature primitives</p>
      <h2 id="sg-prim" class="text-title font-display">Kinetic heading &amp; counters</h2>

      <div class="mt-8 grid gap-12 lg:grid-cols-2">
        <div class="card p-8">
          <p class="eyebrow mb-4">KineticHeading · word reveal</p>
          <KineticHeading
            client:visible
            demo={true}
            text="AI is a time lever."
            as="h3"
            className="text-title font-display"
            accentWords={['lever.']}
          />
        </div>
        <div class="card p-8">
          <p class="eyebrow mb-6">StatCounter · count-up</p>
          <div class="grid grid-cols-2 gap-8">
            <StatCounter client:visible value={11.15} decimals={2} prefix="¥" suffix="M" label="Contracts" demo={true} />
            <StatCounter client:visible value={90} valueTo={95} suffix="%" label="R@5 retrieval" demo={true} />
            <StatCounter client:visible value={40} suffix="%" label="Workload cut" demo={true} />
            <StatCounter client:visible value={200} suffix="+" label="Resources" demo={true} />
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <span class="eyebrow">Eyebrow label</span>
        <span class="inline-flex items-center rounded-full border border-line bg-bg-elev px-3 py-1 font-mono text-xs text-ink-muted">chip / tag</span>
        <span class="inline-flex items-center rounded-full border border-accent/40 bg-accent/10 px-3 py-1 font-mono text-xs text-accent">accent chip</span>
      </div>
    </section>

    <hr class="hairline" />

    <!-- I · HIGHER-ORDER COMPONENT PREVIEWS -->
    <section aria-labelledby="sg-comp" class="reveal" data-reveal>
      <p class="eyebrow mb-3">I · Component states (static previews)</p>
      <h2 id="sg-comp" class="text-title font-display">Building blocks</h2>
      <p class="mt-3 max-w-[64ch] text-ink-muted">
        Visual contract for the interactive components built in later phases
        (Profile timeline, Product cards, diagrams, eval matrix). States shown side by side.
      </p>

      <!-- Nav states -->
      <div class="mt-10">
        <p class="eyebrow mb-4">Nav · top vs scrolled</p>
        <div class="space-y-4">
          <div class="flex items-center justify-between rounded-lg border border-line px-6 py-5">
            <span class="font-display text-lg">Marie Xiaoxu Liu</span>
            <nav class="hidden gap-6 font-mono text-xs uppercase tracking-[0.12em] text-ink-muted sm:flex">
              <span>Guide</span><span>Profile</span><span>Product</span><span>What I Offer</span><span>Contact</span>
            </nav>
          </div>
          <div class="flex items-center justify-between rounded-lg border border-line bg-bg-elev px-6 py-3 shadow-sm">
            <span class="font-display text-base">Marie Xiaoxu Liu</span>
            <nav class="hidden gap-6 font-mono text-xs uppercase tracking-[0.12em] text-ink-muted sm:flex">
              <span>Guide</span><span class="text-ink">Profile</span><span>Product</span><span>What I Offer</span><span>Contact</span>
            </nav>
          </div>
        </div>
      </div>

      <!-- Diagram node states -->
      <div class="mt-10">
        <p class="eyebrow mb-4">InteractiveDiagram node · default / hover / active</p>
        <div class="flex flex-wrap gap-6">
          <div class="rounded-lg border border-line bg-bg-elev px-5 py-4 font-mono text-sm">Data Agent</div>
          <div class="rounded-lg border border-ink bg-bg-elev px-5 py-4 font-mono text-sm text-ink shadow-md">Data Agent</div>
          <div class="rounded-lg border border-accent bg-accent/10 px-5 py-4 font-mono text-sm text-accent shadow-md">Data Agent</div>
        </div>
      </div>

      <!-- Eval matrix cell states -->
      <div class="mt-10">
        <p class="eyebrow mb-4">EvalMatrix cell · default / hover / expanded</p>
        <div class="grid max-w-2xl grid-cols-3 gap-3 font-mono text-xs">
          <div class="rounded border border-line p-4 text-ink-muted">R@k</div>
          <div class="rounded border border-ink p-4 text-ink">R@k</div>
          <div class="col-span-1 row-span-2 rounded border border-accent bg-accent/10 p-4 text-accent">
            R@k<br /><span class="text-ink-muted">90–95% in high-sensitivity</span>
          </div>
        </div>
      </div>

      <!-- Timeline + product card previews -->
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="card p-6">
          <p class="eyebrow mb-4">TimelineCard (preview)</p>
          <div class="flex items-start gap-4">
            <Placeholder id="[LOGO-ZDT]" ratio="1/1" class="w-14 shrink-0" />
            <div>
              <h3 class="font-display text-lg">Senior Product Manager</h3>
              <p class="font-mono text-xs text-ink-muted">ZiDongTaiChu (CAS) · 2024–2026</p>
              <p class="mt-2 text-sm">Owned an enterprise AI Agent platform 0→1.</p>
            </div>
          </div>
        </div>
        <div class="card overflow-hidden">
          <Placeholder id="[VIDEO-PM-01]" ratio="16/9" />
          <div class="p-6">
            <p class="eyebrow mb-2">ProductCard (preview)</p>
            <h3 class="font-display text-lg">Enterprise AI Agent Platform 0→1</h3>
            <p class="mt-2 text-sm text-ink-muted">Design · Tech · Eval · Impact — expandable.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="hairline" />

    <!-- J · MOTION -->
    <section aria-labelledby="sg-motion" class="reveal" data-reveal>
      <p class="eyebrow mb-3">J · Motion language</p>
      <h2 id="sg-motion" class="text-title font-display">Motion</h2>
      <p class="mt-3 max-w-[64ch] text-ink-muted">
        Slow, calm, one thing moving at a time. Easing
        <code class="text-ink">cubic-bezier(0.16, 1, 0.3, 1)</code>. No bounce, no overshoot.
        All of this disables under <code class="text-ink">prefers-reduced-motion</code>.
      </p>

      <!-- marquee -->
      <div class="mt-8">
        <p class="eyebrow mb-4">Logo marquee · ~45s loop · hover to pause</p>
        <LogoMarquee items={marqueeItems} />
      </div>

      <!-- hover image -->
      <div class="mt-10">
        <p class="eyebrow mb-4">Card hover · scale 1.02 + grayscale → color (0.4s)</p>
        <div class="flex flex-wrap gap-6">
          {
            [0, 1, 2].map((i) => (
              <div
                class="hovertile h-40 w-56 rounded-xl border border-line"
                style={`background: linear-gradient(135deg, #C8A45C, #6E7B8B); --i:${i}`}
              />
            ))
          }
        </div>
      </div>

      <!-- reveal note -->
      <div class="mt-10">
        <p class="eyebrow mb-2">Scroll reveal</p>
        <p class="text-sm text-ink-muted">
          Each section on this page (and the site) fades up 20px once on enter, children staggered.
          You triggered them scrolling down.
        </p>
      </div>
    </section>

    <p class="pt-10 text-center font-mono text-xs text-ink-muted">
      End of styleguide · dev-only · noindex
    </p>
  </div>
</BaseLayout>

<style>
  .hovertile {
    filter: grayscale(1);
    transition:
      filter 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }
  .hovertile:hover {
    filter: grayscale(0);
    transform: scale(1.02);
  }
  @media (prefers-reduced-motion: reduce) {
    .hovertile {
      filter: grayscale(0);
    }
  }
</style>
