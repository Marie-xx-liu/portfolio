---
/**
 * Home — a single long scroll, reconstructing the reference site's
 * section grammar over a water backdrop instead of a sky one.
 *
 * The page alternates between two surfaces:
 *   .sheet    — the cream page, scrolling over the fixed water
 *   .porthole — transparent, letting the water through
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkChapter from '../components/WorkChapter.astro';
import FeatureCard from '../components/FeatureCard.astro';
import VoyageTimeline from '../components/VoyageTimeline.astro';
import AheadSection from '../components/AheadSection.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ArcRail from '../components/ArcRail.astro';
import { seo } from '../data/site';
import { hero, chapters, aside } from '../data/home';
---

<BaseLayout title={seo['/'].title} description={seo['/'].description}>
  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero porthole">
    <div class="shell hero__inner">
      <h1 class="hero__type">
        <span class="hero__greeting">{hero.greeting}</span>
        {hero.line}
      </h1>
    </div>
    <div id="nav-sentinel" aria-hidden="true"></div>
    <div class="hero__cue" aria-hidden="true">
      <span>Scroll</span>
      <svg viewBox="0 0 12 24"><path d="M6 2v18M2 16l4 4 4-4" /></svg>
    </div>
  </section>

  <!-- ── The arc, then the work it indexes ────────────────────── -->
  <div class="sheet">
    <div class="shell">
      <section id="arc">
        <ArcRail />
      </section>

      <section id="work" class="section">
        {chapters.map((c) => <WorkChapter chapter={c} />)}

        <!-- Not work: a link out, and one personal card. Held at low
             weight so it cannot demote the case studies above. -->
        <section class="aside" aria-label="Beyond the work">
          <header class="aside__head" data-reveal>
            <span class="aside__label">Also</span>
            <span class="aside__rule"></span>
          </header>
          <div class="aside__grid">
            {aside.map((f, i) => <FeatureCard feature={f} delay={i * 90} />)}
          </div>
        </section>
      </section>
    </div>
  </div>

  <!-- ── A break on open water ────────────────────────────────── -->
  <section class="porthole interlude">
    <div class="shell">
      <blockquote class="interlude__quote" data-reveal>
        A small boat, steered well, crosses more water<br />than a large one adrift.
      </blockquote>
    </div>
  </section>

  <!-- ── Experience + what's ahead ────────────────────────────── -->
  <div class="sheet">
    <div class="shell">
      <section id="experience" class="section">
        <h2 class="section__title section__title--big" data-reveal>
          Past crossings, in the<br />order they happened
        </h2>
        <VoyageTimeline />
      </section>

      <section id="ahead" class="section section--ahead">
        <AheadSection />
      </section>
    </div>
  </div>

  <!-- ── Contact ──────────────────────────────────────────────── -->
  <section id="contact" class="porthole">
    <div class="shell">
      <ContactBlock />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: 140px 120px;
  }

  .hero__inner {
    width: 100%;
  }

  .hero__type {
    /* Wide enough for ~48 characters a line, which lands the copy on 5
       lines like the reference. `balance` is inherited from the base
       heading rule and fights a designed hero, so it is turned off. */
    max-width: 18em;
    text-wrap: normal;
    font-size: var(--text-hero);
    /* The water is bright at dawn but not uniformly so — a soft halo
       keeps the line readable wherever the glitter lands. */
    text-shadow: 0 2px 40px rgb(255 253 250 / 0.75);
  }

  .hero__greeting {
    display: block;
  }

  #nav-sentinel {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }

  .hero__cue {
    position: absolute;
    bottom: 34px;
    left: 50%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .hero__cue svg {
    width: 12px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: drift 2.8s ease-in-out infinite;
  }

  @keyframes drift {
    50% {
      transform: translateY(5px);
      opacity: 0.5;
    }
  }

  /* ── Sections ─────────────────────────────────────────────── */
  .section {
    padding-block: 92px;
  }

  #work {
    padding-block: 24px 60px;
  }

  .section__title {
    font-size: var(--text-h2);
    margin-bottom: 48px;
  }

  .section__title--big {
    font-size: var(--text-hero);
    line-height: 1.02;
  }

  .section--ahead {
    border-top: 1px solid var(--ink-12);
  }

  /* ── Interlude ────────────────────────────────────────────── */
  .interlude {
    display: flex;
    align-items: center;
    min-height: 62svh;
    padding-block: 90px;
  }

  .interlude__quote {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-h2);
    line-height: 1.14;
    color: var(--ink);
    text-shadow: 0 2px 36px rgb(255 253 250 / 0.7);
  }

  /* ── Aside strip ──────────────────────────────────────────── */
  .aside {
    margin-top: 72px;
  }

  .aside__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .aside__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .aside__rule {
    flex: 1;
    height: 1px;
    background: var(--ink-12);
  }

  .aside__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-inline: -24px;
    padding-top: 12px;
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 120px 100px;
    }
    .section {
      padding-block: 64px;
    }
    .aside__grid {
      grid-template-columns: 1fr;
      margin-inline: -16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cue svg {
      animation: none;
    }
  }
</style>
