---
/**
 * The floating capsule nav from the reference site.
 *
 * Over the hero it sits on the water in a translucent glass state; once
 * the cream sheet scrolls under it, it swaps to a solid paper state so
 * it stays legible. The swap is driven by an IntersectionObserver on a
 * sentinel at the end of the hero, not by a scroll listener.
 */
import { site } from '../data/site';
import { href } from '../lib/url';

interface Props {
  /** Detail pages show a back affordance instead of section anchors. */
  variant?: 'home' | 'detail';
}
const { variant = 'home' } = Astro.props;

const links = [
  { href: href('/#work'), label: 'Work' },
  { href: href('/#experience'), label: 'Experience' },
  { href: href('/library'), label: 'Library' },
];
---

<nav class="cap" data-variant={variant} aria-label="Primary">
  <div class="cap__pill">
    {
      variant === 'detail' ? (
        <a class="cap__home" href={href('/')}>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" /></svg>
          <span>Back to the shore</span>
        </a>
      ) : (
        <a class="cap__name" href={href('/')}>{site.name}</a>
      )
    }

    <div class="cap__links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="cap__actions">
      <a class="cap__ghost" href={href('/#contact')}>Contact</a>
      <a class="cap__solid" href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</nav>

<style>
  .cap {
    position: fixed;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    z-index: var(--z-nav);
    width: min(740px, calc(100% - var(--page-pad) * 2));
  }

  .cap__pill {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 8px 0 20px;
    border-radius: 999px;
    /* Glass state — over the water. */
    background: rgb(255 253 250 / 0.72);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 8px 30px rgb(12 31 43 / 0.18);
    transition:
      background 0.45s var(--ease-out-soft),
      box-shadow 0.45s var(--ease-out-soft);
  }

  /* Solid state — set on <html> once the hero has scrolled past. */
  :global(html[data-nav='sheet']) .cap__pill {
    background: rgb(255 253 250 / 0.94);
    box-shadow: 0 6px 24px rgb(28 28 28 / 0.1);
  }

  .cap__name,
  .cap__home {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.2px;
    white-space: nowrap;
  }

  .cap__home {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .cap__home svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.3s var(--ease-out-soft);
  }

  .cap__home:hover svg {
    translate: -3px 0;
  }

  .cap__links {
    display: flex;
    gap: 20px;
    margin-left: auto;
    font-size: var(--text-sm);
  }

  .cap__links a {
    color: var(--ink-70);
    transition: color 0.25s;
  }

  .cap__links a:hover {
    color: var(--ink);
  }

  .cap__actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cap__ghost,
  .cap__solid {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: var(--text-sm);
    white-space: nowrap;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .cap__ghost {
    background: rgb(255 255 255 / 0.7);
    color: var(--ink);
  }

  .cap__ghost:hover {
    background: #fff;
  }

  .cap__solid {
    background: var(--ink);
    color: var(--on-dark);
  }

  .cap__solid:hover {
    background: var(--water-deep);
  }

  @media (max-width: 760px) {
    .cap__links {
      display: none;
    }
    .cap__pill {
      justify-content: space-between;
      padding-left: 16px;
    }
    .cap__actions {
      margin-left: auto;
    }
    .cap__ghost {
      display: none;
    }
  }
</style>

<script>
  // Sentinel lives at the bottom of the hero (see index.astro). When it
  // leaves the viewport the nav is over the cream sheet.
  const sentinel = document.getElementById('nav-sentinel');
  if (sentinel) {
    const io = new IntersectionObserver(
      ([entry]) => {
        document.documentElement.dataset.nav = entry.isIntersecting ? 'water' : 'sheet';
      },
      { rootMargin: '-72px 0px 0px 0px' },
    );
    io.observe(sentinel);
  } else {
    document.documentElement.dataset.nav = 'sheet';
  }
</script>
