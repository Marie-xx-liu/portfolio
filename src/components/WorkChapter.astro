---
/**
 * One employer chapter. Reproduces the reference's block grammar:
 *
 *   org / role / dates  →  marquee strip  →  headline + description
 *   →  Disciplines | My Role (40/60)  →  feature cards (40/60)
 */
import Marquee from './Marquee.astro';
import FeatureCard from './FeatureCard.astro';
import type { WorkChapter } from '../data/home';

interface Props {
  chapter: WorkChapter;
}
const { chapter } = Astro.props;

// Products lead, deployments follow. A chapter with only engagements
// (Deloitte) renders one group, not an empty "Products" heading.
const products = chapter.features.filter((f) => f.kind === 'product');
const engagements = chapter.features.filter((f) => f.kind !== 'product');

const groups = [
  { label: 'Products', items: products },
  { label: 'Deployed as', items: engagements },
].filter((g) => g.items.length > 0);
---

<section class="chapter" id={chapter.id}>
  <header class="chapter__head" data-reveal>
    <h3 class="chapter__org">{chapter.org}</h3>
    <div class="chapter__meta">
      <span>{chapter.role}</span>
      <span class="chapter__right">
        <span class="chapter__stage">{chapter.stageLabel}</span>
        <span class="chapter__dates">{chapter.dates}</span>
      </span>
    </div>
  </header>

  <Marquee text={chapter.marquee} />

  <div class="chapter__intro" data-reveal>
    <h2 class="chapter__headline">{chapter.headline}</h2>
    <p class="chapter__desc">{chapter.description}</p>
  </div>

  <div class="chapter__facts split-4060" data-reveal>
    <div class="fact">
      <span class="eyebrow">Disciplines</span>
      <p>{chapter.disciplines}</p>
    </div>
    <div class="fact">
      <span class="eyebrow">My Role</span>
      <p>{chapter.myRole}</p>
    </div>
  </div>

  {
    groups.map((group) => (
      <section class="group">
        <header class="group__head" data-reveal>
          <span class="group__label">{group.label}</span>
          <span class="group__rule" />
        </header>
        <div class="chapter__cards">
          {group.items.map((f, i) => (
            <FeatureCard feature={f} delay={i * 90} />
          ))}
        </div>
      </section>
    ))
  }
</section>

<style>
  .chapter {
    padding-block: 96px 40px;
  }

  .chapter__head {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding-bottom: 14px;
  }

  .chapter__org {
    font-size: var(--text-h4);
    white-space: nowrap;
  }

  .chapter__meta {
    display: flex;
    flex: 1;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--text-sm);
    color: var(--ink-70);
  }

  .chapter__right {
    display: flex;
    align-items: baseline;
    gap: 16px;
    white-space: nowrap;
  }

  /* Subordinate to the company name, as a classification marker rather
     than a heading. */
  .chapter__stage {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--water-mid);
  }

  .chapter__dates {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .chapter__intro {
    padding-block: 40px 12px;
  }

  .chapter__headline {
    max-width: 17em; /* ~2–4 lines across the 1216 grid, as on the reference */
    font-size: var(--text-h2);
    text-wrap: pretty;
  }

  .chapter__desc {
    margin-top: 26px;
    max-width: 74ch;
    font-size: var(--text-body);
    color: var(--ink-70);
  }

  .chapter__facts {
    padding-block: 34px;
  }

  .fact p {
    margin-top: 8px;
    max-width: 56ch;
    font-size: var(--text-sm);
    color: var(--ink-70);
  }

  .fact + .fact {
    padding-left: 24px;
  }

  /* The reference alternates 486/730 and 730/486 between rows. Flex
     basis (not a fixed grid) lets each card's own `span` decide, so a
     chapter can lead narrow or lead wide with no new CSS. */
  /* ── Product / deployment groups ──────────────────────────── */
  .group + .group {
    margin-top: 16px;
  }

  .group__head {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 26px;
  }

  .group__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-45);
    white-space: nowrap;
  }

  .group__rule {
    flex: 1;
    height: 1px;
    background: var(--ink-12);
  }

  .chapter__cards {
    display: flex;
    flex-wrap: wrap;
    margin-inline: -24px;
    padding-top: 12px;
  }

  .chapter__cards > :global(.card--narrow) {
    flex: 0 0 40%;
  }

  .chapter__cards > :global(.card--wide) {
    flex: 0 0 60%;
  }

  /* A lone card takes the wide slot and leaves the rest as whitespace.
     Growing was fine when every chapter held exactly two cards; now that
     products and deployments are separate groups, a group of one would
     otherwise stretch edge to edge. */
  .chapter__cards > :global(.card:only-child) {
    flex: 0 0 60%;
  }

  @media (max-width: 900px) {
    .chapter {
      padding-block: 64px 24px;
    }
    .chapter__head {
      flex-direction: column;
      gap: 6px;
    }
    .chapter__meta {
      flex-direction: column;
      gap: 2px;
    }
    .chapter__right {
      gap: 12px;
    }
    .chapter__cards {
      flex-direction: column;
      margin-inline: -16px;
    }
    .chapter__cards > :global(.card) {
      flex: 0 0 auto;
    }
    .fact + .fact {
      padding-left: 0;
    }
  }
</style>
